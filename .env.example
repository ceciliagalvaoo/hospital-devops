# Copy this file to .env and adjust the values for your environment.
# .env is ignored by Git; never commit real credentials.

# PostgreSQL database created on first start
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=change-me

# Host port that exposes the application (container port 8000)
APP_PORT=8000

# Runtime environment; development-only commands such as the seed refuse other values
APP_ENV=development

# Password of the development accounts created by: docker compose run --rm app python -m app.seed
SEED_PASSWORD=change-me-dev

# Set to true when the application is served over HTTPS to mark the session cookie Secure
SESSION_COOKIE_SECURE=false

# Host port of the integration-test database (docker compose --profile test)
TEST_DB_PORT=5433
