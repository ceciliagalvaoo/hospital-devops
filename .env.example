# Copy this file to .env and adjust the values for your environment.
# .env is ignored by Git; never commit real credentials.

# PostgreSQL database created on first start
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=change-me

# Host port that exposes the application (container port 8000)
APP_PORT=8000

# Host port of the integration-test database (docker compose --profile test)
TEST_DB_PORT=5433
