<mxfile host="app.diagrams.net" type="device">
  <diagram id="branching-strategy" name="Branching strategy (illustrative)">
    <mxGraphModel dx="1000" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Feature branching in hospital-devops — ILLUSTRATIVE (not the real commit history)" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry"/>
        </mxCell>

        <!-- Branch labels -->
        <mxCell id="lbl-main" value="main (permanent)" style="text;html=1;align=right;verticalAlign=middle;fontStyle=1;fontColor=#1F5FA8;" vertex="1" parent="1">
          <mxGeometry x="20" y="115" width="140" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="lbl-task" value="167-lab5-branching-strategy&lt;br&gt;(temporary)" style="text;html=1;align=right;verticalAlign=middle;fontStyle=1;fontColor=#B85C00;" vertex="1" parent="1">
          <mxGeometry x="0" y="245" width="200" height="40" as="geometry"/>
        </mxCell>

        <!-- Commits on main -->
        <mxCell id="A" value="A" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DAE8FC;strokeColor=#1F5FA8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="115" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="B" value="B" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#DAE8FC;strokeColor=#1F5FA8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="115" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="M" value="M" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#1F5FA8;strokeColor=#1F5FA8;fontColor=#FFFFFF;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="115" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Commits on the task branch -->
        <mxCell id="t1" value="t1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFE6CC;strokeColor=#B85C00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="270" y="250" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="t2" value="t2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFE6CC;strokeColor=#B85C00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="250" width="30" height="30" as="geometry"/>
        </mxCell>
        <mxCell id="S" value="S" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#FFE6CC;strokeColor=#B85C00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="250" width="30" height="30" as="geometry"/>
        </mxCell>

        <!-- Edges: main -->
        <mxCell id="eAB" style="endArrow=none;html=1;strokeColor=#1F5FA8;strokeWidth=3;" edge="1" parent="1" source="A" target="B">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eBM" style="endArrow=none;html=1;strokeColor=#1F5FA8;strokeWidth=3;" edge="1" parent="1" source="B" target="M">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Edges: branch -->
        <mxCell id="eAt1" value="branch from&lt;br&gt;up-to-date main" style="endArrow=classic;html=1;strokeColor=#B85C00;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="A" target="t1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="et1t2" style="endArrow=none;html=1;strokeColor=#B85C00;strokeWidth=2;" edge="1" parent="1" source="t1" target="t2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="et2S" style="endArrow=none;html=1;strokeColor=#B85C00;strokeWidth=2;" edge="1" parent="1" source="t2" target="S">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eBS" value="git merge origin/main&lt;br&gt;(if main moved)" style="endArrow=classic;html=1;dashed=1;strokeColor=#1F5FA8;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="B" target="S">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eSM" value="pull request&lt;br&gt;Create a merge commit" style="endArrow=classic;html=1;strokeColor=#B85C00;strokeWidth=2;fontSize=10;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="S" target="M">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Release tag -->
        <mxCell id="tag" value="tag vX.Y.Z&lt;br&gt;(annotated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#2E7D32;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="105" width="110" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="eTag" style="endArrow=none;html=1;dashed=1;strokeColor=#2E7D32;" edge="1" parent="1" source="tag" target="M">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;A, B — commits already on main&lt;br&gt;t1, t2 — task commits, e.g. &quot;docs: add branching strategy (#167)&quot;&lt;br&gt;S — merge of origin/main into the branch (only when main has moved; conflicts resolved here by the branch author)&lt;br&gt;M — pull-request merge commit on main; the task branch is deleted afterwards&lt;br&gt;Tag — annotated release tag created by the project owner on a validated commit of main" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;rounded=1;strokeColor=#999999;fillColor=#F8F8F8;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="860" height="105" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
